{
  "name": "kumbukum-browser-extension",
  "version": "1.2.0",
  "description": "Save URLs and notes directly to Kumbukum to share with your team and AI assistants.",
  "private": true,
  "scripts": {
    "watch": "webpack --mode=development --watch --config webpack.config.js",
    "build": "export NODE_ENV=production && webpack --mode=production --config webpack.config.js && node pack.js",
    "pack": "node pack.js"
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "generate-json-webpack-plugin": "^2.0.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.106.0",
    "webpack-cli": "^7.0.2",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "easymde": "^2.20.0",
    "marked": "^18.0.0",
    "webextension-polyfill": "^0.12.0"
  }
}
